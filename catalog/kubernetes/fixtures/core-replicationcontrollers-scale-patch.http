# description: Scale ReplicationController replicationcontroller to 3 replicas in namespace shop on cluster shop-prod-dns-4f7a1c2e.hcp.eastus.azmk8s.io
PATCH /api/v1/namespaces/shop/replicationcontrollers/replicationcontroller/scale HTTP/1.1
Host: shop-prod-dns-4f7a1c2e.hcp.eastus.azmk8s.io
Authorization: Bearer opf_kubernetes_EXAMPLE
Accept: application/json
Content-Type: application/merge-patch+json

{"spec":{"replicas":3}}
