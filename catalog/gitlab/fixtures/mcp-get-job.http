# description: Show job 2002 in project acme/shop
POST /api/v4/mcp HTTP/1.1
Host: gitlab.com
Authorization: Bearer opf_gitlab_EXAMPLE
Content-Type: application/json
Accept: application/json, text/event-stream

{"jsonrpc": "2.0", "id": 1, "method": "tools/call", "params": {"name": "get_job", "arguments": {"id": "acme/shop", "job_id": 2002, "include": ["log"]}}}
