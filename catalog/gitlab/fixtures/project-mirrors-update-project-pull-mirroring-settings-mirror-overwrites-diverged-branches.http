# description: Change where project acme/shop pulls its branches from (mirror_overwrites_diverged_branches)
PUT /api/v4/projects/acme%2Fshop/mirror/pull HTTP/1.1
Host: gitlab.com
PRIVATE-TOKEN: opf_gitlab_EXAMPLE
Content-Type: application/json

{"enabled": true, "url": "https://github.com/acme/shop.git", "mirror_overwrites_diverged_branches": "true"}
